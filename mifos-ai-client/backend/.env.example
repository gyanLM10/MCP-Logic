# Mifos AI Client — Environment Variables
# Copy to .env and fill in your values

# Ollama Model Name
OLLAMA_MODEL=qwen2.5:7b

# ABOSLUTE PATH to the Mifos MCP Server script
# In production, this points to wherever you cloned the `mcp-mifosx` repository
MCP_SERVER_PATH=/opt/mifos/mcp-mifosx/Python/MCP-Server-Python-Implementation/mcp_server.py

# PostgreSQL Connection String
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgresql://mifos:password@localhost:5433/mifos_chat

# Fineract backend credentials (these get read by the mcp_server.py subprocess)
MIFOSX_BASE_URL=https://localhost:8443/fineract-provider/api/v1
MIFOSX_TENANT_ID=default
MIFOSX_USERNAME=mifos
MIFOSX_PASSWORD=password
